<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Versão SEM ADMINISTRADOR: executável que se conecta ao SOLIDWORKS aberto.
    Não precisa de RegAsm nem das DLLs de interop para compilar: as chamadas à API
    são feitas por ligação tardia (dynamic) e as constantes são lidas da instalação
    do SOLIDWORKS em tempo de execução (SwConst.cs).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>StepExporterApp</AssemblyName>
    <RootNamespace>StepExporter</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <Product>Exportador STEP em Lote</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\ExportCommand.cs" Link="Shared\ExportCommand.cs" />
    <Compile Include="..\src\ComponentCollector.cs" Link="Shared\ComponentCollector.cs" />
    <Compile Include="..\src\ExportDialog.cs" Link="Shared\ExportDialog.cs" />
    <Compile Include="..\src\StepExportService.cs" Link="Shared\StepExportService.cs" />
    <Compile Include="..\src\SwConst.cs" Link="Shared\SwConst.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>

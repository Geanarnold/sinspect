<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Versão SEM ADMINISTRADOR: executável que se conecta ao SOLIDWORKS aberto.
    Não precisa de RegAsm. A API do SOLIDWORKS vem do NuGet (DLLs distribuídas junto, não embutidas).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>GeradorDeSTEP</AssemblyName>
    <RootNamespace>StepExporter</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.2</Version>
    <InformationalVersion>rev.02</InformationalVersion>
    <ApplicationIcon>..\src\icons\step.ico</ApplicationIcon>
    <Product>Gerador de STEP</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\ExportCommand.cs" Link="Shared\ExportCommand.cs" />
    <Compile Include="..\src\ComponentCollector.cs" Link="Shared\ComponentCollector.cs" />
    <Compile Include="..\src\ExportDialog.cs" Link="Shared\ExportDialog.cs" />
    <Compile Include="..\src\StepExportService.cs" Link="Shared\StepExportService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SolidWorks.Interop.sldworks" Version="32.1.0" />
    <PackageReference Include="SolidWorks.Interop.swconst" Version="32.1.0" />
  </ItemGroup>


</Project>

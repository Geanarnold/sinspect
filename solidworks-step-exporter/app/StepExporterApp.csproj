<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Versão SEM ADMINISTRADOR: executável que se conecta ao SOLIDWORKS aberto.
    Não precisa de RegAsm. Reaproveita o código de ../src (exceto o add-in COM).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StepExporterApp</AssemblyName>
    <RootNamespace>StepExporter</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <Product>Exportador STEP em Lote</Product>
    <SwInstallDir Condition="'$(SwInstallDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SwInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\ExportCommand.cs" Link="Shared\ExportCommand.cs" />
    <Compile Include="..\src\ComponentCollector.cs" Link="Shared\ComponentCollector.cs" />
    <Compile Include="..\src\ExportDialog.cs" Link="Shared\ExportDialog.cs" />
    <Compile Include="..\src\StepExportService.cs" Link="Shared\StepExportService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwInstallDir)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwInstallDir)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>

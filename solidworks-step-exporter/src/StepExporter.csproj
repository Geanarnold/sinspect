<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Add-in COM para SOLIDWORKS (.NET Framework 4.8, x64).
    As DLLs da API vêm do NuGet e são EMBUTIDAS na DLL (EmbedInteropTypes):
    o plugin é um único arquivo StepExporter.dll e funciona com SOLIDWORKS 2019+.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>StepExporter</AssemblyName>
    <RootNamespace>StepExporter</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <Company>Gean Arnold</Company>
    <Product>Exportador STEP em Lote</Product>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SolidWorks.Interop.sldworks" Version="32.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SolidWorks.Interop.swconst" Version="32.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SolidWorks.Interop.swpublished" Version="32.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Embute os tipos da API (não é preciso distribuir as DLLs de interop). -->
  <Target Name="EmbedSolidWorksInterop" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="$([System.String]::Copy('%(Filename)').StartsWith('SolidWorks.Interop.'))">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
